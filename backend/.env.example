# Server
PORT=3000
BACKEND_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# Upstream LLM servers (JSON array)
# Each model must have a unique name across all servers.
# Simple single-server setup:
SERVERS=[{"name":"Local","statsUrl":null,"models":[{"name":"default","url":"http://localhost:8080/v1"}]}]

# Multi-server with model routing:
# SERVERS=[{"name":"Local","statsUrl":null,"models":[{"name":"Qwen3.6-27B-FP8","url":"http://localhost:8080/v1"},{"name":"llama3","url":"http://localhost:8081/v1"}]},{"name":"Remote","statsUrl":"http://remote-host:3000","models":[{"name":"codellama","url":"http://remote-host:8080/v1"}]}]

SUPPRESS_CONSOLE=false

# Upstream timeout (milliseconds) - max time for a single request to complete
UPSTREAM_TIMEOUT_MS=3600000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
DATABASE_PATH=backend/data/database.sqlite

# Security
SESSION_SECRET=<generate-a-secure-random-string>
SESSION_EXPIRY_HOURS=24

# Multi-domain support (optional)
# Comma-separated list of allowed hostnames for CORS and URL validation
# Leave empty to allow any domain (useful for dev)
# Examples:
#   ALLOWED_DOMAINS=localhost:5173,localhost:3000
#   ALLOWED_DOMAINS=192.168.1.100:80,mygateway.ts.net:80
ALLOWED_DOMAINS=

